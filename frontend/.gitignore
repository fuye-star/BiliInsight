# ============================================================
# 前端 .gitignore
# ============================================================

node_modules/
dist/
dist-ssr/

# Vite 缓存
.vite/
*.local

# 日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 编辑器
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# 环境变量（.env.development / .env.production 是模板，允许提交）
.env.local
.env.*.local

# 类型检查缓存
*.tsbuildinfo
