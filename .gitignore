# ============================================================
# BiliInsight .gitignore
# ============================================================

# ---------- 环境变量与密钥（严禁提交）----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
.venv/
venv/
env/
ENV/
.python-version

# ---------- Django ----------
*.log
db.sqlite3
db.sqlite3-journal
/backend/media/
/backend/staticfiles/
/backend/logs/

# ---------- 测试与缓存 ----------
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/
celerybeat-schedule
celerybeat-schedule.*
celerybeat.pid

# ---------- Node / Vue ----------
node_modules/
dist/
dist-ssr/
.vite/
*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.eslintcache

# ---------- 爬取数据与向量库（体积大，不提交）----------
data/
*.csv
*.xlsx
*.parquet
/chroma/
*.sqlite3

# ---------- 模型文件 ----------
*.onnx
*.pdparams
*.pdmodel
*.bin
*.safetensors
models/

# ---------- 数据合规：原始爬取结果不入库 ----------
/raw_data/
/exports/

# ---------- IDE ----------
.idea/
.vscode/
*.swp
*.swo
*~

# ---------- 操作系统 ----------
.DS_Store
Thumbs.db
desktop.ini

# ---------- 构建产物 ----------
*.zip
*.tar.gz

# ---------- 桌面打包产物（体积巨大，不入库）----------
dist_desktop/
build_desktop/

# ---------- 临时工作目录 ----------
.tmp/
_scratch/

# ---------- 本地运行数据（SQLite / Chroma / 日志 / 密钥）----------
backend/data/
backend/.desktop/
.desktop/
secret.key

# ---------- 源码汇总文件（体积大，按需重新生成）----------
源代码.md
源代码.txt
源文件汇总.md
