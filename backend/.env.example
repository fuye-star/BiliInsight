# ============================================================
# BiliInsight 环境变量模板
# 用法：Copy-Item .env.example .env  然后按需修改
# 注意：.env 已在 .gitignore 中，切勿提交真实密钥
# ============================================================

# ---------------- Django ----------------
DJANGO_SECRET_KEY=change-me-to-a-random-50-char-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ---------------- MySQL ----------------
# 端口取决于你用哪种部署方式：
#   原生安装 MySQL       -> 3306
#   Docker compose 部署  -> 3307（本机已有原生 MySQL 时用这个，避免冲突）
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3307
MYSQL_DATABASE=biliinsight
MYSQL_USER=bili
MYSQL_PASSWORD=bili_pass_2026

# ---------------- Redis ----------------
# 原生 Memurai 或 Docker 容器均为 6379，无需区分
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/1
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2

# ---------------- AI Provider（对话生成）----------------
# 可选值：ollama | dashscope | deepseek
#   ollama    本地免费可离线（需先启动 Ollama 服务并 pull 模型）
#   dashscope 阿里云通义千问（需 API Key + 外网）
#   deepseek  DeepSeek 官方 API（OpenAI 兼容格式，价格极低）
# 三者都不可用时自动降级为"检索式回答"（用真实数据组织回答并明确标注）
AI_PROVIDER=ollama

# --- 方案 A：本地 Ollama ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=deepseek-r1:8b

# --- 方案 B：通义千问（DashScope）---
DASHSCOPE_API_KEY=
AI_MODEL=qwen-plus

# --- 方案 C：DeepSeek 官方 API（推荐，便宜且效果好）---
# 申请 Key：https://platform.deepseek.com/api_keys
# ⚠️ 模型名必须填 deepseek-flash，不要填 deepseek-v4.1-flash
#    DeepSeek-V4.1-Flash 是【版本名】，API 的【模型名】是 deepseek-flash
#    填版本名会直接报"模型不存在"
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# ---------------- 向量库（ChromaDB）----------------
CHROMA_PERSIST_DIR=./data/chroma

# ---------------- 向量化后端（RAG 检索用）----------------
# 可选值：local | ollama | dashscope
#   local     = 本地 TF-IDF + SVD，纯 Python 零依赖、开箱即用（默认，推荐）
#               局限：属于词法匹配，非语义理解（"芯片"匹配不到"半导体"）
#   ollama    = 本地嵌入模型，语义效果好且可离线，需先启动 Ollama 并 pull 模型
#   dashscope = 通义千问 embedding，效果最好，需 API Key + 外网
# ⚠️ 切换后端后必须重建索引：python manage.py build_index --rebuild
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=bge-m3

# ---------------- 情感分析后端 ----------------
# 可选值：snownlp | paddlenlp
#   snownlp   = 纯 Python，无需编译，支持 Python 3.13（默认，推荐）
#   paddlenlp = 百度飞桨，需 Python 3.11/3.12（在 3.13 上装不了，见 requirements-paddle.txt）
# 业务逻辑与实现解耦，切换只需改这一行
SENTIMENT_BACKEND=snownlp

# ---------------- 爬虫合规配置 ----------------
# 请求间隔（秒）—— 请勿低于 1.0，默认 2.0，尊重目标站点
SPIDER_REQUEST_INTERVAL=2.0
SPIDER_MAX_RETRIES=3
SPIDER_TIMEOUT=15
SPIDER_USER_AGENT=Mozilla/5.0 (compatible; BiliInsight/1.0; Educational-Research)

# ---------------- 缓存 TTL（秒）----------------
CACHE_TTL_HOT_VIDEOS=300
CACHE_TTL_RANKING=600
